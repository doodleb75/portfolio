<script>
function ID_(){
	if(document.all.mem_id.value=="아이디"){
		document.all.mem_id.value="";
	}
}
function PW_(){
	if(document.all.mem_pw.value=="비밀번호"){
		document.all.mem_pw.value="";
	}
}
function login(){
	if(!document.all.mem_id.value){alert("아이디를 입력해 주세요"); document.all.mem_id.focus(); return;}
	if(!document.all.mem_pw.value){alert("비밀번호를 입력해 주세요"); document.all.mem_pw.focus(); return;}

	document.loginFrm.login_id.value = document.all.mem_id.value;
	document.loginFrm.login_pw.value = document.all.mem_pw.value;

	document.loginFrm.submit();
}
function No_01_tab(no){
	if(no==1){
		document.getElementById("1_01").className="selected";
		document.getElementById("1_02").className="";
		document.getElementById("1_04").className="";
		document.getElementById("1_01_title").style.display="block";
		document.getElementById("1_02_title").style.display="none";
		document.getElementById("1_04_title").style.display="none";
	}
	if(no==2){
		document.getElementById("1_01").className="";
		document.getElementById("1_02").className="selected";
		document.getElementById("1_04").className="";
		document.getElementById("1_01_title").style.display="none";
		document.getElementById("1_02_title").style.display="block";
		document.getElementById("1_04_title").style.display="none";
	}
	if(no==4){
		document.getElementById("1_01").className="";
		document.getElementById("1_02").className="";
		document.getElementById("1_04").className="selected";
		document.getElementById("1_01_title").style.display="none";
		document.getElementById("1_02_title").style.display="none";
		document.getElementById("1_04_title").style.display="block";
	}
}
function No_02_tab(no){
	if(no==1){
		document.getElementById("2_01").className="selected";
		document.getElementById("2_02").className="";
		document.getElementById("2_03").className="";
		document.getElementById("2_01_title").style.display="block";
		document.getElementById("2_02_title").style.display="none";
		document.getElementById("2_03_title").style.display="none";
	}
	if(no==2){
		document.getElementById("2_01").className="";
		document.getElementById("2_02").className="selected";
		document.getElementById("2_03").className="";
		document.getElementById("2_01_title").style.display="none";
		document.getElementById("2_02_title").style.display="block";
		document.getElementById("2_03_title").style.display="none";
	}
	if(no==3){
		document.getElementById("2_01").className="";
		document.getElementById("2_02").className="";
		document.getElementById("2_03").className="selected";
		document.getElementById("2_01_title").style.display="none";
		document.getElementById("2_02_title").style.display="none";
		document.getElementById("2_03_title").style.display="block";

	}
}

// 이부분부터  수정할 필요 없습니다. 
function getCookie(name) { 
var Found = false 
var start, end 
var i = 0 
 
while(i <= document.cookie.length) { 
start = i 
end = start + name.length 
 
if(document.cookie.substring(start, end) == name) { 
Found = true 
break 
} 
i++ 
} 
 
if(Found == true) { 
start = end + 1 
end = document.cookie.indexOf(";", start) 
if(end < start) 
end = document.cookie.length 
return document.cookie.substring(start, end) 
} 
return "" 
} 
// 이부분 까지는 수정할 필요 없습니다. 
 
function openPopup() 
{ 
var noticeCookie=getCookie("parking");  // 쿠키네임 지정
if (noticeCookie != "no") 
window.open('pop/noticeID.html','pop','width=600,height=490,top=0,left=0'); 
// window.open('팝업창 웹페이지','윈도우명','width=350,height=400,top=50,left=150'); 
} 
//openPopup();  // 자동으로 팝업 띄우기
</script>
