/* 워크보드 독립 url */
#personalWB{width:800px;}
#personalWB #wbUrl{width:780px;padding:0 10px;}
#personalWB #wbUrl dt.userInfo{float:left;font-size:11px;color:#808080;padding:15px 0 6px 0;}
#personalWB #wbUrl dt.userInfo span.name{font-size:11px;color:#202020;font-weight:bold;}
#personalWB #wbUrl dt.userInfo span.url{font:11px Verdana;color:#c3c3c3;font-weight:bold;}
#personalWB #wbUrl dd.industryCate{float:right;font-size:11px;color:#808080;padding:15px 0 6px 0;}
#personalWB #wbUrl dd.industryCate span.cate{font-size:11px;color:#e8010a;font-weight:bold;}
#personalWB #wbUrl dd.line{list-style:none; clear:both;height:1px; width:100%; background:#e5e5e5; overflow:hidden;font-size:0 !important; line-height:0 !important;}
#personalWB #workBody{width:780px;margin:0 10px;background:url("../images/showcase/workBodyBg.gif");}
#personalWB #workBody #workLnb{float:left;width:170px;padding:15px 10px;}
#personalWB #workBody #workLnb li.myWorkList{list-style:none; clear:both;width:170px;height:20px;border-bottom:2px solid #666;font-size:12px;color:#202020;font-weight:bold;}
#personalWB #workBody #workLnb li.myWorkList span{color:#e8010a;font-weight:bold;}
#personalWB #workBody #workLnb li.workImg{float:left;width:65px;padding:6px 0 2px 0;text-align:center;}
#personalWB #workBody #workLnb li.workTitle{float:left;font-size:11px;color:#202020;font-weight:bold;width:95px;padding:12px 0 0 5px;line-height:1.2em;}
#personalWB #workBody #workLnb li.workTitle a{font-size:11px;color:#202020;font-weight:bold;line-height:1.2em;}
#personalWB #workBody #workLnb li.line{list-style:none; clear:both;height:1px; width:170px; background:#c0c0c0; overflow:hidden;font-size:0 !important; line-height:0 !important;}
#personalWB #workBody #workLnb li.dv{list-style:none; clear:both;height:20px; width:170px; overflow:hidden;font-size:0 !important; line-height:0 !important;}
#personalWB #workBody #workLnb li.paging{list-style:none; clear:both;text-align:center;}
#personalWB #workBody #workMain{float:right;width:570px;padding:15px 0;}
#personalWB #workBody #workMain li.workTitle{list-style:none; clear:both;font-size:14px;height:20px;border-bottom:2px solid #c7c7c7;color:#202020;font-weight:bold;line-height:1.2em;}
#personalWB #workBody #workMain li.workImg{list-style:none; clear:both;width:570px;text-align:center;padding:10px 0 40px 0;}
#personalWB #workBody #workMain li.thumbImg{list-style:none; clear:both;padding:0 0 0 50px;cursor:pointer;}
#personalWB #workBody #workMain li.thumbImg p{float:left;}
#personalWB #workBody #workMain li.thumbImg p img{border:1px solid #eaeaea;margin:0 5px;}
#personalWB #workBody #workMain li.workInfo{list-style:none; clear:both;width:570px;font-size:12px;color:#202020;padding:20px 10px 23px 0;}
#personalWB #workBody #workMain li.line1{list-style:none; clear:both;height:1px; width:100%; background:#e5e5e5; overflow:hidden;font-size:0 !important; line-height:0 !important;}
#personalWB #workBody #workMain li.workEdit{float:left;padding:6px 0 1px 0;}
#personalWB #workBody #workMain li.scrap{float:right;padding:6px 0 0 0;font-size:11px;color:#202020;}
#personalWB #workBody #workMain li.scrap a{font-size:11px;color:#202020;text-decoration:none;}
#personalWB #workBody #workMain li.scrap span.sc{font-size:11px;color:#e8010a;}
#personalWB #workBody #workMain li.scrap span.sc a{font-size:11px;color:#e8010a;text-decoration:none;}
#personalWB #workBody #workMain li.scrap span.dv{font-size:10px;color:#e0e0e0;}
#personalWB #workBody #workMain li.line2{list-style:none; clear:both;height:2px; width:100%; background:#c7c7c7; overflow:hidden;font-size:0 !important; line-height:0 !important;}
#personalWB #personalHeader h1{width:800px;}
#personalWB #personalFooter{width:800px;border-top:2px solid #000;}
#personalWB #personalFooter address{font:10px Verdana;font-weight:normal;color:#000;text-align:center;padding:12px 0;}
/* 덧글-별점 */
.repleWriteWB {width:570px;padding:20px 0 0 0;}
.repleWriteWB li.title {float:left; font:12px 돋움;color:#202020; text-align:left;padding-top:10px;font-weight:bold;}
.repleWriteWB li.attention {float:right; text-align:right;font:11px 돋움;color:#818181;}
.repleWriteWB li.attention p {font:11px 돋움;}
.repleWriteWB li.line {list-style:none; clear:both; font-size:0; border-bottom:1px solid #ddd; overflow:hidden;margin-top:-15px;_margin-top:5px;}
.repleWriteWB li.line2 {list-style:none; clear:both; font-size:0; border-bottom:1px solid #ddd; overflow:hidden;}
.repleWriteWB li.reple {float:left; font:11px 돋움;color:#7f7f7f; text-align:left;padding:8px 0 10px 0;}
.repleWriteWB li.reple input {width:410px; height:18px;border:1px solid #cacaca;background:#fff;line-height:1.2em;padding:0 7px;}
.repleWriteWB li.btnRe {float:right; text-align:right;font-size:0;padding:8px 0 10px 0;}
.repleWriteWB li.btnRe input.red {text-align:center;font:11px 돋움;color:#e8010a;padding:5px 0;width:60px;height:20px;border-style:none;cursor:pointer;background:url("../images/common/btnStarMark.gif");}
.repleWriteWB li.viewReple {list-style:none; clear:both; font:11px 돋움;padding:10px 0 8px 0;color:#999;}
.repleWriteWB li.viewReple span {font:11px Verdana;font-weight:bold;color:#999;}
.repleWriteWB li.repleName {float:left; font:11px 돋움;width:100px;color:#7f7f7f; text-align:left;padding:7px 0 4px 0;}
.repleWriteWB li.powerName {float:left; font:11px 돋움;width:100px;color:#7f7f7f; text-align:left;padding:7px 0 4px 20px;background:url("../images/common/iconPower.gif") no-repeat 0 4px;}
.repleWriteWB li.repleList {float:left; font:11px 돋움;width:395px;color:#7f7f7f; text-align:left;padding:7px 0 4px 0;}
.repleWriteWB li.repleEdit {float:left; width:395px;text-align:left;padding:7px 0 4px 0;}
.repleWriteWB li.repleEdit input.reple {font-size:11px;width:220px;height:16px;border:1px solid #cacaca;background:#fff;padding:0 7px;}
.repleWriteWB li.repleDate {float:left; font:10px Verdana;width:75px;color:#7f7f7f; text-align:center;padding:7px 0 4px 0;}
.repleWriteWB li.repleLine {list-style:none; clear:both; font-size:0; height:1px; background:url("../images/common/repleDot.gif") bottom;}
.starMarkWB {width:570px;height:24px; padding:8px 0; border-top:1px solid #ddd; border-bottom:1px solid #ddd; overflow:hidden;}
.starMarkWB li.mark {float:left; font:11px 돋움; text-align:left;padding-top:3px;}
.starMarkWB li.ment {float:left; font:11px 돋움; text-align:left;padding-top:8px;}
.starMarkWB li.btnMark {float:right; text-align:right;font-size:0;padding-top:2px;}
.starMarkWB li.btnMark input.star {text-align:center;font:11px 돋움;color:#e8010a;padding:5px 0;width:70px;height:20px;border-style:none;cursor:pointer;background:url("../images/common/btnReple2.gif");}

