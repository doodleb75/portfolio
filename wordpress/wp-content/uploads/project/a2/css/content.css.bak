.mainLogin2 li.myIndus span{font-size:11px;font-weight:bold;color:#484848;letter-spacing:0em;}
.mainLogin2 li.paperInfo{list-style:none;float:left;font:11px 돋움;width:50px;text-align:left;color:#595959;padding:2px 0 0 19px;line-height:1.4em;}
.mainLogin2 li.count{list-style:none;float:left;font:11px 돋움;width:20px;text-align:right;font-weight:bold;color:#ef222e;padding:2px 0 0 8px;line-height:1.4em;}
.mainLogin2 li.count a{font:11px 돋움;font-weight:bold;color:#ef222e;text-decoration:none;line-height:1.4em;}
.mainLogin2 li.clean{list-style:none;clear:both;font-size:0;}
.mainLogin2 li.btnMyShowcase{list-style:none;clear:both;font-size:0;text-align:center;padding-top:10px;}
.eventNseminar{width:215px;padding-top:22px;}
.eventNseminar li.title{font-size:0;}
.eventNseminar li.borderBox{width:213px;height:70px;padding:5px 0 3px 0;border:1px solid #dcdcdc;background:#fff;}
.eventNseminar li p.data a{font-size:11px;color:#6b6d70;padding:3px 5px 0 18px;background:url("../images/common/listDotS.gif") no-repeat 13px 8px;text-decoration:none;line-height:1.7em;}
.eventNseminar li p.data a:hover{color:#ff4e4d;text-decoration:none;}
.eventNseminar li p.line{height:1px;padding:0 0 4px 13px;}
.mainVideo2 li.title{font-size:0;padding-top:18px;}
.mainVideo2 li{font-size:0;width:215px;}
