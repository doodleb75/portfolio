/* 끝(2010.07.02) */
#contentMain{width:463px;text-align:left;}
.wellMain{width:443px;margin-bottom:20px;}
:root .wellMain{width:443px;padding-top:10px;}
.wellMain div.title{float:left;padding-top:4px;}
.wellMain div.mainTab{float:right;}
.tabList{}
.tabList li{float:left; _display:inline; margin-right:-1px; font-size:11px; border:1px solid #d8d8d8; color:#808080; background:url("../images/common/industryTabBg.gif") left top;}
.tabList li a{_float:left; display:block; height:18px; padding:4px 10px 0 11px; font-size:11px; color:#808080; text-decoration:none; background:url("../images/common/industryTabBg.gif") left top;}
.tabList li a:hover{font-size:11px; color:#000; background:#fff;}
.tabList li.selected{border-bottom:1px solid #fff; background-image:none;}
.tabList li.selected a{color:#000; font-size:11px; font-weight:bold; letter-spacing:0; background-image:none;}
.mainThumb {list-style:none; width:440px; padding:5px 0 0 0;}
.mainThumb li span {font-size:11px;color:#808080;text-align:left;}
.mainThumb li.blogTitle {clear:both; _height:0; _font-size:0;}
	.photo_blog {background-color:#fff; font:12px 돋움, Dotum; overflow:hidden;}
	.photo_blog dd.photoBox {display:inline; float:left; margin:0 18px 0 0; font-size:0; color:#fff; text-align:center;border:1px solid #e6e6e6;padding:4px;}
	.photo_blog dd {line-height:1.6em;padding-top:2px;background:url("../images/common/listDot.gif") no-repeat 148px 9px;}
	.photo_blog dd img {border:none;}
	.photo_blog a {font-size:12px;color:#595959; text-decoration:none;}
	.photo_blog a:hover {color:#ff4e4d;text-decoration:none;}
.showcase {width:443px;margin-top:5px;}
.showcase li.title{font-size:0;padding:0 0 8px 0;}
.showcase li.img{font-size:0;}
/* 메인컨텐츠(2010.07.02 부터) */
.showcaseBox {width:463px;margin-bottom:30px;}
.showcaseBox li.title{float:both;font-size:0;padding:0 0 8px 0;}
.showcaseBox li.showBox{float:left;width:152px;height:144px;background:url("../images/mainNew/bgShowbox1.gif") no-repeat;}
:root .showcaseBox li.showBox{padding-bottom:30px;}
.showcaseBox li dl{width:115px;padding:9px 0 0 10px;}
.showcaseBox li dt.pic{font-size:0;width:115px;height:72px;}
.showcaseBox li dd.title{font-size:11px;font-weight:bold;width:115px;color:#6b7383;line-height:1.2em;padding:9px 0 0 0;}
.showcaseBox li dd.title a{font-size:11px;font-weight:bold;color:#6b7383;text-decoration:none;line-height:1.2em;}
.showcaseBox li dd.nick{font-size:11px;color:#85868a;padding:6px 0 0 0;}
.showcaseBox li.showBoxEnd{float:left;width:159px;height:144px;background:url("../images/mainNew/bgShowbox2.gif") no-repeat;}
:root .showcaseBox li.showBoxEnd{padding-bottom:30px;}
/* 끝(2010.07.02) */
#mainRight{width:215px;text-align:left;}
:root #mainRight{margin-left:17px;}
.mainLogin{width:213px;height:90px;margin-top:16px;text-align:center;border:1px solid #cbcbcb;background:#fff;}
.mainLogin li.id{list-style:none;clear:both;text-align:left;padding:10px 0 0 11px;}
.mainLogin li.pw{float:left;text-align:left;padding:3px 0 0 11px;}
.mainLogin li.btnLogin{float:left;text-align:left;padding:0 0 0 8px;margin-top:-22px;}
.mainLogin li.join{list-style:none;clear:both;font:11px 돋움;text-align:left;padding:0 0 0 11px;}
.mainLogin li.logined{list-style:none;clear:both;font:12px 돋움;text-align:left;padding:8px 0 0 12px;color:#484848;}
.mainLogin li.logined span{font-weight:bold;color:#484848;}
.mainLogin li.paperInfo{list-style:none;clear:both;font:11px 돋움;text-align:left;color:#595959;padding:3px 0 0 27px;line-height:1.5em;background:url("../images/main/iconPaper.gif") no-repeat 12px 8px;}
.mainLogin li.paperInfo span{font-weight:bold;color:#ef222e;}
.mainLogin li.btnMyShowcase{list-style:none;clear:both;font-size:0;text-align:center;padding-top:8px;}
/* 메인컨텐츠(2010.07.02 부터) */
.mainLogin2{width:215px;height:135px;margin-top:16px;text-align:center;background:url("../images/mainNew/loginedBox.gif") no-repeat;}
