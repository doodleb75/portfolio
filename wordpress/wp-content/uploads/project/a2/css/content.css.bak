.docuList li.getTitle a{font-size:14px;font-weight:bold;color:#202020;text-decoration:none;}
.docuList li span.dataCount{font-size:11px;font-weight:bold;color:#707070;padding:0 0 10px 0;}

/* 쪽지보기 팝업 */
.paperView {width:350px;padding:23px 20px 0 20px;}
.lineMargin{margin-top:-20px;}
.paperView li.sendTitle {float:left;font:12px 돋움;color:#454444;width:75px;font-weight:bold;}
.paperView li.sendName {float:left; font:12px 돋움;color:#666;}
.paperView li.sendName a {font:12px 돋움;color:#666;text-decoration:none;}
.paperView li.receiveTtile {float:left;font:12px 돋움;color:#828181;width:75px;font-weight:bold;padding:8px 0;}
.paperView li.receiveTime {float:left; font:11px Verdana;color:#666;padding:8px 0;}
.paperView li.todaySend {list-style:none;clear:both;font:12px 돋움;color:#666;padding:0 0 2px 0;margin-top:-3px;}
.paperView li.todaySend span.title {font:12px 돋움;color:#828181;font-weight:bold;}
.paperView li.todaySend span.today {font:12px 돋움;color:#66c8d2;font-weight:bold;}
.paperView li.todaySend span.dv {font:12px 돋움;color:#ccc;}
.paperView li.receiveTitle2 {float:left;font:12px 돋움;color:#454444;width:53px;font-weight:bold;padding:8px 0;}
.paperView li.receiveName {float:left; font:12px 돋움;color:#666;padding:8px 0;}
.paperView li.receiveName a {font:12px 돋움;color:#666;padding:8px 0;text-decoration:none;}
.paperView li.line{list-style:none;clear:both;height:1px; width:100%; background:#e2e2e2; overflow:hidden;font-size:0 !important; line-height:0 !important;}
.paperView li.filed textarea.con {list-style:none;clear:both;border:1px solid #adafaa;width:332px;height:150px;color:#333;background:#fff;line-height:1.5em;padding:8px;}
.paperView li.content {float:left; font:12px 돋움;color:#666;padding:10px 0 20px 0;}
.paperView li.content2 {float:left; font:12px 돋움;color:#454444;padding:2px 0 0 0;font-weight:bold;}
.paperView li.content3 {list-style:none;clear:both;font:12px 돋움;color:#666;padding:3px 0 20px 20px;}
.paperView li.byte {float:right; font:12px 돋움;color:#666;padding:7px 0 0 0;}
.paperView li.next {float:right; font:12px 돋움;color:#666;padding:10px 0 20px 0;}
.paperView li.next a {font:12px 돋움;color:#666;padding:10px 0 20px 0;text-decoration:none;}
.paperView li.btnPaper {list-style:none;clear:both;text-align:center;line-height:0;padding-top:12px;}
.searchIDNick select{list-style:none;clear:both;font:11px 돋움;color:#454444;}
.searchIDNick input.text{list-style:none;clear:both;font:11px 돋움;width:200px;height:17px;color:#454444;border:1px solid #e2e2e2;line-height:1.5em;}
.btnPaperSend{font-size:12px;color:#666;padding:5px 0;}
.listIDNick{width:348px;height:150px;overflow-y:scroll;overflow-x:hidden;}
.listIDNick table{margin:0;padding:0;width:100%;border-top:1px solid #adafaa;border-left:1px solid #adafaa;border-right:1px solid #adafaa;border-collapse:collapse;}
.listIDNick th{padding:5px 0 3px 10px; border-bottom:solid 1px #adafaa;font-weight:bold; font-size:11px; color:#666;text-align:left;}
.listIDNick td{padding:5px 0 3px 10px; border-bottom:solid 1px #adafaa;font-size:11px; color:#666;text-align:left;}

/* 게시판 스타일 - 기본 */
.boardList{width:716px;}
.boardtype1{width:100%; border-top:2px solid #66c8d2; font-size:12px; table-layout:fixed; border-collapse:collapse;}
.boardtype1 caption{display:none;}
.boardtype1 thead th{line-height:1em; padding:10px 0 5px 0; border-bottom:solid 1px #e2e2e2;background-color:#fff; font-weight:bold; font-size:11px; color:#666; vertical-align:top;text-align:center;}
.boardtype1 thead th.frm input{width:15px;height:15px;margin-top:-3px;}
.boardtype1 thead th.frm select{width:130px;height:18px;margin-top:-4px;font-size:11px;font-weight:normal;}
.boardtype1 tbody td{padding:5px 0 3px 0; text-align:center; border-bottom:solid 1px #e2e2e2;}
/*.boardtype1 tbody td{white-space:nowrap; text-overflow:ellipsis; overflow:hidden;}*/
.boardtype1 tbody td.frm{padding:0;text-align:center;}
.boardtype1 tbody td.frm input{width:15px;height:15px;margin-top:0;}
.boardtype1 tbody td a{color:#666;text-decoration:none;}
.boardtype1 tbody td{color:#999;}
.boardtype1 tbody td.num,
.boardtype1 tbody td.date,
.boardtype1 tbody td.hit{font:normal 11px Verdana; color:#a3a3a3; padding:0;}
.boardtype1 tbody td.category{font:normal 11px 돋움; color:#666; padding:0;text-align:left;padding-left:6px;}
.boardtype1 tbody td.title{text-align:left; padding-left:15px;}
.boardtype1 tbody td.title .pic,
.boardtype1 tbody td.title .new{margin:0 0 2px; vertical-align:middle;}
.boardtype1 tbody td span.comment{background:none;padding:0;font:10px Verdana;font-weight:bold;color:#666;}
.boardtype1 tbody tr.reply td.title a{padding-left:30px;background:url("../images/common/iconRe.gif") 0 1px no-repeat;}
.boardtype1 tbody tr.reply td span.comment{background:none;padding:0;font:10px Verdana;font-weight:bold;color:#666;}
.boardtype1 tbody td.event{padding:10px 0;text-align:center;}
.boardtype1 tbody td.eventInfo{padding:10px 0;text-align:left;vertical-align:top;color:#909090;}
.boardtype1 tbody td.eventInfo p.title {font-weight:bold;padding:7px 10px 13px 20px;}
.boardtype1 tbody td.eventInfo p.title a{color:#00a3b4;}
.boardtype1 tbody td.eventInfo p.evTitle a{font-weight:bold;color:#00a3b4;padding:7px 10px 13px 20px;}
.boardtype1 tbody td.eventInfo p.day{font-size:11px;padding:0 0 7px 20px;line-height:1.2em;}
.boardtype1 tbody td.eventInfo span.period{font:11px Verdana;padding:0 0 7px 0;line-height:1.2em;}
.boardtype1 tbody td.eventInfo p.description1{font-size:11px;padding:0 0 7px 20px;line-height:1.2em;}
.boardtype1 tbody td.eventInfo p.description2{font-size:11px;padding:0 10px 7px 20px;line-height:1.2em;}
.boardtype1 tbody td.eventInfo p.description3{font-size:11px;padding:0 10px 4px 20px;line-height:1.2em;}
.boardtype1 tbody td.findPP p.nick {padding:5px 0;text-align:left;}
.boardtype1 tbody td.findPP p.nick {font-size:11px;color:#00a3b4;line-height:1.2em;text-align:left;text-decoration:none;}
.boardtype1 tbody td.findPP p.intro{font-size:11px;color:#666;padding:0 0 5px 0;line-height:1.2em;text-align:left;}
