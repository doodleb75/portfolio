.eventBanner li.title{font-weight:bold;color:#484848;padding-top:14px;line-height:1.2em;}
.eventBanner li.img{font-size:0;padding-top:5px;}
.twitterBanner li{margin-left:17px;padding-top:16px;font-size:0;}
