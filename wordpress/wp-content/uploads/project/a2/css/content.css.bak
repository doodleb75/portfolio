.starCount{position:absolute;margin-left:370px;font-size:11px;color:#e8010a;text-align:right;padding:5px 0 3px 0;line-height:1em;}
:root .starCount{position:absolute;margin-left:610px;font-size:11px;color:#e8010a;text-align:right;padding:5px 0 3px 0;line-height:1em;}
.conName{font:14px 돋움;color:#00a3b4;line-height:1.7em;padding-top:3px;font-weight:bold;line-height:1.2em;}
.bestChoice{text-align:right;padding:5px 7px 0 0;font-weight:bold;color:#333;}
/* Paginate */
.paginate { padding:7px 0; text-align:right;}
.paginate a img { border:none; vertical-align:middle; _vertical-align:top;}
.paginate a,
.paginate strong { position:relative; margin-left:-6px; display:inline-block; vertical-align:middle; _width /**/:18px; padding:2px 6px 3px 7px; color:#00a3b4; text-decoration:none; line-height:normal; font:11px Tahoma; background:url("../images/common/linePage.gif") no-repeat left center;}
.paginate a:hover { text-decoration:underline;}
.paginate strong { color:#333 !important; font-weight:bold;}
.paginate .first-child { background:none;}
.paginate a.pre,
.paginate a.next { padding:0; background:none !important;}
.paginate a.pre { margin:0 5px 0 -6px;}
.paginate a.next { margin:0 3px 0 0;}

/* 워크보드 상세 */
.titleBox{width:716px;height:30px;background:url("../images/common/titleBox.gif");}
.titleBox p{font-size:14px;font-weight:bold;color:#212121;padding:5px 0 0 11px;}
.titleBox span{font-size:14px;font-weight:bold;color:#00a3b4;}

.wbDetailBox{width:716px;}
.workImg{width:340px;float:left;}
.workViewer dt{width:328px;clear:both;cursor:pointer;text-align:center;border:1px solid #dcdcdc;padding-top:4px;}
.workViewer dd{float:left;margin:8px 6px 0 0;}
.workViewer dd img{border:1px solid #dcdcdc;cursor:pointer;}
.workInfo{width:360px;float:right;}
.workInfo table{margin:auto;text-align:left;font-size:12px;border-collapse:collapse;}
.workInfo th {font:14px 돋움;color:#00a3b4;padding:20px 0 17px 0;font-weight:bold;text-align:left;vertical-align:top;}
.workInfo td {font:12px 돋움;color:#818181;}
.workInfo td p.description1 {font:12px 돋움;color:#818181;text-align:right;padding:8px 7px 0 0;}
.workInfo td p.description2 {font:12px 돋움;color:#818181;padding-bottom:8px;}
.workInfo td p.description6 {font:12px 돋움;color:#818181;line-height:1.3em;padding:0 7px 10px 0;}
.workInfo td p.btnList{text-align:center;padding:12px 0;}
.workInfo td p * {vertical-align:middle;}
.workInfo td span.description3 {font:11px Verdana;color:#00a4b4;}
.workInfo td span.description4 {font:11px Verdana;color:#818181;}
.workInfo td span.description5 {font:8px Verdana;color:#818181;}

.starMark {width:716px;height:27px; padding:8px 0; border-top:1px solid #ddd; border-bottom:1px solid #ddd; overflow:hidden;}
.starMark li.mark {float:left; font:12px 돋움; text-align:left;padding-top:3px;}
.starMark li.ment {float:left; font:12px 돋움; text-align:left;padding-top:8px;}
.starMark li.btnMark {float:right; text-align:right;font-size:0;}

.repleWrite {width:716px;padding:20px 0 0 0;}
.repleWrite li.title {float:left; font:12px 돋움;color:#202020; text-align:left;padding-top:10px;font-weight:bold;}
.repleWrite li.attention {float:right; text-align:right;font:11px 돋움;color:#818181;}
.repleWrite li.attention p {font:11px 돋움;}
.repleWrite li.line {list-style:none; clear:both; font-size:0; border-bottom:1px solid #ddd; overflow:hidden;margin-top:-15px;_margin-top:5px;}
.repleWrite li.reple {float:left; font:12px 돋움;color:#7f7f7f; text-align:left;padding:13px 0 20px 0;}
.repleWrite li.reple input {width:540px; height:25px;border:1px solid #cacaca;background:#fff;line-height:2em;padding:0 7px;}
.repleWrite li.btnRe {float:right; text-align:right;font-size:0;padding:13px 0 20px 0;}
.repleWrite li.viewReple {list-style:none; clear:both; font:11px 돋움;padding-bottom:8px;color:#999;}
.repleWrite li.viewReple span {font:11px Verdana;font-weight:bold;color:#999;}
.repleWrite li.repleName {float:left; font:12px 돋움;width:100px;color:#7f7f7f; text-align:left;padding:7px 0 4px 0;}
.repleWrite li.powerName {float:left; font:12px 돋움;width:100px;color:#7f7f7f; text-align:left;padding:7px 0 4px 20px;background:url("../images/common/iconPower.gif") no-repeat 0 4px;}
.repleWrite li.repleList {float:left; font:12px 돋움;width:530px;color:#7f7f7f; text-align:left;padding:7px 0 4px 0;}
.repleWrite li.repleEdit {float:left; width:540px;text-align:left;padding:7px 0 4px 0;}
.repleWrite li.repleEdit input.reple {font-size:11px;width:350px;height:16px;border:1px solid #cacaca;background:#fff;padding:0 7px;}
.repleWrite li.repleDate {float:left; font:11px Verdana;width:75px;color:#7f7f7f; text-align:center;padding:7px 0 4px 0;}
.repleWrite li.repleLine {list-style:none; clear:both; font-size:0; height:1px; background:url("../images/common/repleDot.gif") bottom;}

