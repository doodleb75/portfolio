.myA2Title li.more{float:right;padding:0 10px 0 0;}
.myA2 {width:350px; height:95px; padding:10px 0 20px 0;}
.myA2 li {list-style:none; clear:both; color:#828282; font:12px 돋움; overflow:hidden;text-align:left;line-height:0;}
.myA2 li img.storyImg {display:inline; float:left; margin:0 15px 0 0;}

.doubleLine{width:716px;padding:5px 0; height:24px; border-top:1px solid #ddd; border-bottom:1px solid #ddd; overflow:hidden;}
.imageWite{width:716px;padding:9px 0 20px 0;}
.imageWite li.title {float:left; font:12px 돋움;width:15%;color:#7d7d7d; text-align:left;padding:8px 0 1px 0;font-weight:bold;}
.imageWite li.filed {float:right;width:85%; text-align:left;padding:1px 0;font-size:12px;}
.imageWite li.filed input.fileUp {border:1px solid #cacaca;width:98%;height:25px;background:#fff;line-height:2.5em;}
.contestCheck{width:716px;border-bottom:1px solid #ddd; overflow:hidden;}
.contestCheck li.check{list-style:none; clear:both; font:12px 돋움;color:#828282;padding-bottom:7px;text-align:left;text-decoration:underline;}
.contestCheck li.check input{width:15px;height:15px;margin-right:5px;}
.contestCheck li.title {float:left; font:12px 돋움;width:15%;color:#7d7d7d; text-align:center;padding:12px 0 0 0;font-weight:bold;border-top:1px solid #ddd; overflow:hidden;}
.contestCheck li.filed {float:right;width:85%; text-align:left;padding:5px 0;border-top:1px solid #ddd; overflow:hidden;}
.contestCheck li.filed input.fileUp {border:1px solid #cacaca;width:99%;height:22px;background:#fff;line-height:2em;}
.contestCheck li.filed textarea {border:1px solid #cacaca;width:99%;height:160px;background:#fff;overflow:hidden;}
