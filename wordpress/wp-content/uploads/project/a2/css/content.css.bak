.fixHeight{height:120px;}
.contestNo{font-size:11px;color:#666;line-height:1.2em;padding:0 0 3px 3px;}
.contestTitle{font-size:11px;color:#666;line-height:1.2em;width:140px;padding:6px 0 4px 3px;}
