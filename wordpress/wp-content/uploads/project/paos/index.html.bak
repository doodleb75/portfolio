		background: -moz-linear-gradient(left,  #9dd53a 0%, #a1d54f 42%, #80c217 58%, #7cbc0a 100%); /* FF3.6-15 */
		background: -webkit-linear-gradient(left,  #9dd53a 0%,#a1d54f 42%,#80c217 58%,#7cbc0a 100%); /* Chrome10-25,Safari5.1-6 */
		background: linear-gradient(to right,  #9dd53a 0%,#a1d54f 42%,#80c217 58%,#7cbc0a 100%); /* W3C, IE10+, FF16+, Chrome26+, Opera12+, Safari7+ */
		filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#9dd53a', endColorstr='#7cbc0a',GradientType=1 ); /* IE6-9 */

		background-image: url('images/main/bg.jpg') ;
		background-repeat: no-repeat;
		background-position:  left bottom;
	}
	.swf-wrap{
		position:  absolute;
		width:  100%;
		bottom:  0;
	}
	.footer{
		height:  20%;
		text-align:  center;
		background:  ;
	}
	.footer img{
	    margin: 46px;
		margin-left:  360px;
	}
</style>
</head>
