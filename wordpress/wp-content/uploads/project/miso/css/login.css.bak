*{margin:0;padding:0;}
image{border:0;}
body{background:url(../images/login_t_bg.gif) repeat-x;}
#log_wrap{min-height:100%;}
#log_top_bar{height:4px;background:#666;}
#log_container{margin:0 auto;width:539px;margin-top:185px;}
.pr_name{text-align:center;}
.ideti_title{margin-top:43px;text-align:center;}

.log_box{position:relative;margin:0 auto;width:529px;height:323px;background:url(../images/logbox_bg.png) no-repeat;}
.log_box fieldset{border:0;}
.log_box legend,.log_box label{display:none;}
.id_input,.pw_input{border:0;font:bold 12pt verdana,dotum;color:#444;padding:6px 7px;width:210px;}

.log_in_box{position:absolute;top:105px;margin-left:104px;}
.p_uid,.p_upw{padding-top:8px;height:35px;}
.log_btn_area{position:absolute;top:0px;right:-100px;}

.logo_5678{margin:0 auto;margin-top:63px;text-align:center;}