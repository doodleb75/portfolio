 @charset "utf-8";
 @import url("monitor_menu.css");

 *{margin:0;padding:0;/*overflow:auto;overflow:hidden;*/}
  html,body{height:100%;}
  p,h1,h2,h3{margin:0;padding:0;}
  a,a:hover{text-decoration:none;}
  ul,li,dl,dd,dt{list-style:none;}
  img{border:0;vertical-align:middle;}
  
  /**레이아웃**/
  #header,#contents,#bg_left,#bg_right,#footer{position:absolute;}
  #header{width:100%;height:88px;background:#333;z-index:100;}
  #h_box{width:auto;min-width:1000px;height:88px;background:url(../images/t_center_bg.gif) repeat-x;}
  .h_left{width:7px;height:88px;float:left;background:url(../images/t_left_bg.gif) no-repeat;}
  .h_right{width:7px;height:88px;float:right;background:url(../images/t_right_bg.gif) no-repeat;}
  #bg_left{width:7px;min-height:100%;background:#ddd;z-index:10;background:url(../images/m_left_bg.gif) repeat-y;}
  #bg_right{width:7px;right:0;min-height:100%;background:#ddd;z-index:10;background:url(../images/m_right_bg.gif) repeat-y;}
  *html #bg_left,*html #bg_right{height:100%;}
  
  #footer{width:100%;height:7px;background:#f5f5f5;bottom:0;z-index:80;overflow:hidden;}
  #f_box{width:auto;min-width:1000px;height:7px;background:url(../images/f_center_bg.gif) repeat-x;}
  .f_left{width:7px;height:7px;float:left;background:url(../images/f_left_bg.gif) no-repeat;}
  .f_right{width:7px;height:7px;float:right;background:url(../images/f_right_bg.gif) no-repeat;}
  /** //레이아웃**/
 

 /**상단영역**/
  .logo_area{position:absolute;top:15px;left:15px;}

  /** 상단오른쪽 **/
  #header_right{position:absolute;top:0px;right:20px;font:12px verdana,dotum;color:#404040;}
  *html #header_right{top:0px;right:20px;_right:20px;}
  .admin{float:left;margin-top:10px;margin-right:15px;}
  .admin_bool img{padding-right:6px;}
  .admin_bool{margin-right:10px;}
  .clock{float:left;margin-top:18px;margin-right:35px;padding-left:22px;display:inline-block;background:url(../images/icon_clock.gif) no-repeat left 50%;font:bold 11px verdana;color:#000;letter-spacing:-1px;}
  .small_logo{display:inline-block;margin-top:10px;}
  /** //상단오른쪽 **/

/** //상단영역**/

  /** 컨텐츠 **/
  #contents{width:100%;height:100%;top:0px;margin-bottom:-7px;background:url(../images/line_bg.gif);overflow:auto;}
  .con_box{margin-top:88px;margin-left:12px;overflow:auto;}
  /** //컨텐츠 **/

